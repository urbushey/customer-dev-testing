CREATE MATERIALIZED VIEW 82a268020f8d4419810fe335c75f623d TAGS = ('_nio_interactive') AS WITH id_level_data AS (
    SELECT t._rosetta_stone.sha256_hashed_email AS sha256_hashed_email,
        t._rosetta_stone.sha256_hashed_phone_number AS sha256_hashed_phone_number,
        t._rosetta_stone.mobile_id_unique_identifier AS mobile_id_unique_identifier,
        MAX(
            CASE
                WHEN (
                    t._rosetta_stone.generational_cohort = 'Millennials'
                ) THEN 1
                ELSE 0
            END
        ) AS f1
    FROM company_data.ADDRESSABLE_AUDIENCE AS t
    WHERE (
            (
                (
                    t._rosetta_stone.sha256_hashed_email.type IS NOT NULL
                )
                AND (
                    t._rosetta_stone.sha256_hashed_email."value" IS NOT NULL
                )
            )
            OR (
                (
                    t._rosetta_stone.sha256_hashed_phone_number.type IS NOT NULL
                )
                AND (
                    t._rosetta_stone.sha256_hashed_phone_number."value" IS NOT NULL
                )
            )
            OR (
                (
                    t._rosetta_stone.mobile_id_unique_identifier.type IS NOT NULL
                )
                AND (
                    t._rosetta_stone.mobile_id_unique_identifier."value" IS NOT NULL
                )
            )
        )
    GROUP BY t._rosetta_stone.sha256_hashed_email,
        t._rosetta_stone.sha256_hashed_phone_number,
        t._rosetta_stone.mobile_id_unique_identifier
)
SELECT COUNT(
        CASE
            WHEN (f1 = 1) THEN 1
        END
    ) AS full_query_count,
    COUNT(
        CASE
            WHEN f1 = 1 THEN 1
        END
    ) AS f1_count
FROM id_level_data 