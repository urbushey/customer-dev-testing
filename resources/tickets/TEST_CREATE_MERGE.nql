CREATE MATERIALIZED VIEW "test_merge_2025110522"
DESCRIPTION = 'test' TAGS = ('_nio_audience') AS
SELECT company_data.Audience_Builder_Test_Dataset_._rosetta_stone.sha256_hashed_email AS sha256_hashed_email,
    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.mobile_id_unique_identifier AS mobile_id_unique_identifier,
    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.narrative_id AS narrative_id,
    CURRENT_TIMESTAMP AS last_modified_at
FROM company_data.Audience_Builder_Test_Dataset_
WHERE (
        company_data.Audience_Builder_Test_Dataset_._rosetta_stone.hl7_gender.gender IN ('male', 'female')
    )
    AND (
        (
            (
                (
                    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.sha256_hashed_email.type IS NOT NULL
                )
                AND (
                    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.sha256_hashed_email."value" IS NOT NULL
                )
            )
            OR (
                (
                    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.mobile_id_unique_identifier.type IS NOT NULL
                )
                AND (
                    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.mobile_id_unique_identifier."value" IS NOT NULL
                )
            )
            OR (
                (
                    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.narrative_id.type IS NOT NULL
                )
                AND (
                    company_data.Audience_Builder_Test_Dataset_._rosetta_stone.narrative_id."value" IS NOT NULL
                )
            )
        )
    ) MERGE ON target.sha256_hashed_email IS NOT DISTINCT
FROM source.sha256_hashed_email
    AND target.mobile_id_unique_identifier IS NOT DISTINCT
FROM source.mobile_id_unique_identifier
    AND target.narrative_id IS NOT DISTINCT
FROM source.narrative_id
    AND target.last_modified_at > current_timestamp - interval '1296000' second
    WHEN NOT MATCHED THEN
INSERT (
        sha256_hashed_email,
        mobile_id_unique_identifier,
        narrative_id,
        last_modified_at
    ) VALUES (
        source.sha256_hashed_email,
        source.mobile_id_unique_identifier,
        source.narrative_id,
        source.last_modified_at
    )